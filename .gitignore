# ========================================================
# FindMissingPerson - Git Ignore Rules
# ========================================================

# 1. Flutter & Dart Build Outputs & Caches
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
/build/
**/doc/api/
**/ios/Flutter/.last_build_id

# 2. Binary Installers & APK Outputs (Unnecessary Large Files)
*.apk
*.aab
*.dex
*.ipa
APK_INSTALL/
FindMissingPerson.apk
FindMissingPerson_NEW_FINAL.apk
**/build/app/outputs/

# 3. Android Build & Local Machine Artifacts
**/.gradle/
.gradle/
**/android/.gradle/
**/android/captures/
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/**/gradle-wrapper.jar

# 4. Security, Secrets & API Keys (Strictly Excluded)
lib/config/secrets.dart
android/app/google-services.json
*.env
*.env.*
*.jks
*.keystore
key.properties
secrets.json

# 5. IDE & Editor Artifacts
.idea/
*.iml
*.ipr
*.iws
.vscode/
.atom/
.history
.buildlog/

# 6. Operating System & Miscellaneous
.DS_Store
Thumbs.db
*.log
*.tmp
*.class
*.swp
*.pyc

# 7. Explicit Exceptions (Templates to keep tracked)
